new file mode 100644
index 0000000..c2e371f
--- /dev/null
+++ b/workshop/nanovllm_moe/services/utils/per_step_trace.py
@@ -0,0 +1,342 @@
+"""Per-step / per-layer / per-rank STRUCTURAL trace recorder (Phase: collection).
+
+Enabled ONLY when MOE_COLLECT_PER_STEP=1. Default OFF → record_step() returns
+immediately with zero overhead (no file is created, no work is done).
+
+Design contract (see docs/aris/idea-expansion/04_collection_schema.md):
+  - STRUCTURAL ONLY. No timing fields. Per-segment latency lives in the tier1
+    microbench (decision B at GATE Pre-Stage).
+  - ZERO new GPU sync on the per-layer hot path. The recorded quantities are
+    already host-synced by the caller (send_counts/recv_counts were `.tolist()`-ed
+    at dispatch_ep_ht.py :365-366) or pure CPU reads.
+  - Streaming append + per-step fsync (crash loss <= 1 step).
+
+GLOBAL phase / warmup (Finding 1 fix, GATE B):
+  `phase` and `is_warmup` must be RANK-CONSISTENT. A rank's LOCAL is_prefill is
+  per-OWNER: an idle rank (no owned tokens) sees is_prefill=False even during a
+  cluster-wide prefill step, which mislabels phase and breaks onset/warmup.
+  Fix:
+    - GLOBAL phase: model_runner.run() does a guarded MAX all-reduce of local
+      is_prefill across ranks each step and calls set_global_phase(...). All
+      ranks then record the same phase for the same step.
+    - WARMUP: the harness calls set_warmup(True/False) around its warmup loop
+      (identical on every rank since the harness is SPMD) — authoritative. If a
+      harness never calls it (e.g. GSM8K child), we fall back to prefill-onset
+      counting vs MOE_COLLECT_WARMUP_BATCHES, which is now also rank-consistent
+      because the onset is computed on the GLOBAL phase.
+
+step_id: incremented on layer_id rollover (forward restarts at the lowest MoE
+layer; all 48 layers are MoE).
+"""
+from __future__ import annotations
+
+import json
+import os
+import struct
+import time
+from pathlib import Path
+from typing import Any, BinaryIO, TextIO
+
+import numpy as np
+
+# Module-level state. A fresh process (each torchrun invocation) starts clean.
+_ENABLED: bool | None = None
+_FH: TextIO | None = None
+_STEP: int = 0
+_LAST_LAYER: int = -1
+_RUN_ID: str | None = None
+_OUT_DIR: str | None = None
+# global phase / warmup
+_GLOBAL_PHASE: bool | None = None     # set by model_runner each step (rank-consistent)
+_WARMUP_EXPLICIT: bool | None = None  # set by harness set_warmup(); authoritative if not None
+_WARMUP_BATCHES: int | None = None    # K fallback from env
+_PREFILL_ONSETS: int = 0
+_PREV_PHASE: str | None = None        # last KNOWN global phase ("prefill"/"decode")
+# Stage D0: topk sidecar binary (see docs/aris/idea-expansion/topk_sidecar_format_v1.md)
+_TOPK_FH: BinaryIO | None = None
+_TOPK_K: int | None = None            # cached for file-level header validation
+
+SIDECAR_MAGIC = b"TKBN"
+SIDECAR_VERSION = 1
+SIDECAR_FILE_HEADER_SIZE = 8           # magic(4) + version(1) + K(1) + reserved(2)
+SIDECAR_RECORD_HEADER_SIZE = 12        # step_id(4) + layer_id(4) + T(4)
+
+
+def enabled() -> bool:
+    global _ENABLED
+    if _ENABLED is None:
+        _ENABLED = os.environ.get("MOE_COLLECT_PER_STEP", "0") == "1"
+    return _ENABLED
+
+
+def set_global_phase(is_prefill: bool | None) -> None:
+    """Set the rank-consistent GLOBAL phase for the current step. Called once per
+    step by model_runner.run() (after a MAX all-reduce of local is_prefill)."""
+    global _GLOBAL_PHASE
+    _GLOBAL_PHASE = None if is_prefill is None else bool(is_prefill)
+
+
+def set_warmup(flag: bool) -> None:
+    """Authoritative warmup toggle, called by the harness around its warmup loop.
+    Identical across ranks (SPMD harness), so rank-consistent without broadcast."""
+    global _WARMUP_EXPLICIT
+    _WARMUP_EXPLICIT = bool(flag)
+
+
+def _warmup_batches() -> int:
+    global _WARMUP_BATCHES
+    if _WARMUP_BATCHES is None:
+        try:
+            _WARMUP_BATCHES = int(os.environ.get("MOE_COLLECT_WARMUP_BATCHES", "0"))
+        except ValueError:
+            _WARMUP_BATCHES = 0
+    return _WARMUP_BATCHES
+
+
+def _run_id() -> str:
+    global _RUN_ID
+    if _RUN_ID is None:
+        _RUN_ID = os.environ.get("MOE_COLLECT_RUN_ID") or time.strftime("%Y%m%d_%H%M%S")
+    return _RUN_ID
+
+
+def _out_dir() -> str:
+    global _OUT_DIR
+    if _OUT_DIR is None:
+        _OUT_DIR = os.environ.get(
+            "MOE_COLLECT_OUT_DIR",
+            "/home/lzy/Artifact-Infer/docs/aris/idea-expansion/raw_collection",
+        )
+    return _OUT_DIR
+
+
+def _topk_path(rank: int) -> Path:
+    return Path(_out_dir()) / f"per_step_trace_{_run_id()}_rank{rank}_topk.bin"
+
+
+def _topk_handle(rank: int, K: int) -> BinaryIO:
+    """Open the sidecar binary file. Same hardening contract as the jsonl
+    handle: if the (run_id, rank) sidecar exists, raise FileExistsError unless
+    MOE_COLLECT_FORCE_APPEND=1. Writes the 8-byte file header (TKBN magic +
+    version=1 + K + reserved) on first open."""
+    global _TOPK_FH, _TOPK_K
+    if _TOPK_FH is None:
+        out_dir = _out_dir()
+        Path(out_dir).mkdir(parents=True, exist_ok=True)
+        path = _topk_path(rank)
+        force_append = os.environ.get("MOE_COLLECT_FORCE_APPEND", "0") == "1"
+        if path.exists() and not force_append:
+            raise FileExistsError(
+                f"topk sidecar already exists: {path}\n"
+                f"  (run_id={_run_id()!r}, rank={rank}). Same hardening as the "
+                f"jsonl: appending would conflate two collection passes.\n"
+                f"  -> Use a fresh MOE_COLLECT_RUN_ID (e.g. add a suffix), or "
+                f"set MOE_COLLECT_FORCE_APPEND=1."
+            )
+        _TOPK_FH = open(path, "ab" if force_append else "wb")
+        # If the file is empty (fresh write or freshly force-appended into an
+        # empty file), emit the file header now.
+        if _TOPK_FH.tell() == 0:
+            assert 0 < K < 256, f"K must fit in u8 byte (0..255), got {K}"
+            header = SIDECAR_MAGIC + bytes([SIDECAR_VERSION, K]) + b"\x00\x00"
+            assert len(header) == SIDECAR_FILE_HEADER_SIZE
+            _TOPK_FH.write(header)
+            _TOPK_FH.flush()
+        _TOPK_K = K
+    return _TOPK_FH
+
+
+def _write_topk_record(
+    rank: int, step_id: int, layer_id: int, T: int, K: int,
+    ids_bytes: bytes, w_bytes: bytes,
+) -> int:
+    """Write one record to the sidecar and return its byte offset (= start of
+    the record's step_id field). Sidecar layout: little-endian throughout, no
+    inter-record padding. See topk_sidecar_format_v1.md."""
+    fh = _topk_handle(rank, K)
+    offset = fh.tell()
+    fh.write(struct.pack("<III", int(step_id), int(layer_id), int(T)))
+    fh.write(ids_bytes)
+    fh.write(w_bytes)
+    return offset
+
+
+def _handle(rank: int) -> TextIO:
+    global _FH
+    if _FH is None:
+        out_dir = _out_dir()
+        Path(out_dir).mkdir(parents=True, exist_ok=True)
+        path = Path(out_dir) / f"per_step_trace_{_run_id()}_rank{rank}.jsonl"
+        # Hardening (GATE C): refuse to append to an existing (run_id, rank)
+        # file — that silently concatenates two model passes (e.g. a profiling
+        # pass + an eval pass) into one file, as seen with the GSM8K pipeline.
+        # Granularity is per (run_id, rank): each rank writes its own file, so
+        # only a true collision (same run_id AND same rank already on disk)
+        # raises. Set MOE_COLLECT_FORCE_APPEND=1 to opt back into append.
+        force_append = os.environ.get("MOE_COLLECT_FORCE_APPEND", "0") == "1"
+        if path.exists() and not force_append:
+            raise FileExistsError(
+                f"per_step_trace output already exists: {path}\n"
+                f"  (run_id={_run_id()!r}, rank={rank}). Appending would conflate "
+                f"two collection passes.\n"
+                f"  -> Use a fresh MOE_COLLECT_RUN_ID (e.g. add a timestamp/clean "
+                f"suffix), or set MOE_COLLECT_FORCE_APPEND=1 to append on purpose."
+            )
+        # Fresh file by default ('w'); 'a' only when force-append is requested.
+        _FH = open(path, "a" if force_append else "w", buffering=1)
+    return _FH
+
+
+def record_step(
+    *,
+    layer_id: int,
+    rank: int,
+    send_counts: list[int],
+    recv_counts: list[int],
+    num_tokens: int,
+    hidden_size: int,
+    elem_size: int,
+    k_eff: int,
+    k_model: int,
+    e_global: int,
+    world_size: int,
+    drop_policy: str,
+    drop_rate: float,
+    is_source_leader: bool,
+    # Stage D0 (D1-I10 / D2-I5 replay support, opt-in):
+    # Flattened length-(T*K) lists. Caller is responsible for the ONE host-sync
+    # (a single combined .cpu().tolist() in dispatch_ep_ht.py). Stored as int /
+    # float in JSON; semantically uint8 expert ids (E<=128) and float16-rounded
+    # router weights. When None, fields are simply omitted from the record.
+    topk_ids: list[int] | None = None,
+    topk_weights: list[float] | None = None,
+) -> None:
+    """Append one structural record. No-op (instant return) when disabled.
+    Phase/warmup come from the rank-consistent GLOBAL state, not local context."""
+    if not enabled():
+        return
+
+    global _STEP, _LAST_LAYER, _PREFILL_ONSETS, _PREV_PHASE
+
+    new_step = _LAST_LAYER >= 0 and layer_id <= _LAST_LAYER
+    if new_step:
+        _STEP += 1
+        # fsync BOTH jsonl and topk sidecar on step boundary so they advance
+        # together. Crash mid-step bounds loss to <= 1 step in BOTH files.
+        if _FH is not None:
+            try:
+                _FH.flush()
+                os.fsync(_FH.fileno())
+            except (OSError, ValueError):
+                pass
+        if _TOPK_FH is not None:
+            try:
+                _TOPK_FH.flush()
+                os.fsync(_TOPK_FH.fileno())
+            except (OSError, ValueError):
+                pass
+    _LAST_LAYER = layer_id
+
+    phase = (
+        ("prefill" if _GLOBAL_PHASE else "decode")
+        if _GLOBAL_PHASE is not None else "unknown"
+    )
+
+    # prefill-onset (batch) counting on the GLOBAL phase -> rank-consistent.
+    if phase == "prefill" and _PREV_PHASE != "prefill":
+        _PREFILL_ONSETS += 1
+    if phase in ("prefill", "decode"):
+        _PREV_PHASE = phase
+
+    if _WARMUP_EXPLICIT is not None:
+        is_warmup = _WARMUP_EXPLICIT
+    else:
+        is_warmup = _PREFILL_ONSETS <= _warmup_batches()
+
+    L_send = int(sum(send_counts))
+    L_recv = int(sum(recv_counts))
+    rec: dict[str, Any] = {
+        "run_id": _run_id(),
+        "step_id": _STEP,
+        "layer_id": int(layer_id),
+        "rank_id": int(rank),
+        "phase": phase,
+        "is_warmup": bool(is_warmup),
+        "batch_index": int(_PREFILL_ONSETS),
+        "num_tokens": int(num_tokens),
+        "L_send": L_send,
+        "L_recv": L_recv,
+        "send_counts": [int(x) for x in send_counts],
+        "recv_counts": [int(x) for x in recv_counts],
+        "hidden_size": int(hidden_size),
+        "elem_size": int(elem_size),
+        "K_eff": int(k_eff),
+        "K_model": int(k_model),
+        "E_global": int(e_global),
+        "world_size": int(world_size),
+        "drop_policy": str(drop_policy),
+        "drop_rate": float(drop_rate),
+        "is_source_leader": bool(is_source_leader),
+    }
+    # Topk sidecar binary (D0). When both lists are provided, encode them as
+    # int8 + float16 and write a single record into the per-rank sidecar; store
+    # only an offset (+ T, K) in the jsonl so the structural log stays small.
+    # See docs/aris/idea-expansion/topk_sidecar_format_v1.md.
+    if topk_ids is not None and topk_weights is not None:
+        T_K = len(topk_ids)
+        assert len(topk_weights) == T_K, (
+            f"topk_ids/topk_weights length mismatch: {T_K} vs {len(topk_weights)}"
+        )
+        K = int(k_eff)
+        if T_K > 0:
+            assert T_K % K == 0, f"len(topk_ids)={T_K} not divisible by K={K}"
+            T = T_K // K
+            ids_np = np.asarray(topk_ids, dtype=np.int8)
+            w_np = np.asarray(topk_weights, dtype=np.float16)
+            ids_bytes = ids_np.tobytes()
+            w_bytes = w_np.tobytes()
+            offset = _write_topk_record(
+                rank=rank, step_id=_STEP, layer_id=int(layer_id),
+                T=T, K=K, ids_bytes=ids_bytes, w_bytes=w_bytes,
+            )
+            rec["topk_offset"] = int(offset)
+            rec["topk_T"] = int(T)
+            rec["topk_K"] = int(K)
+        else:
+            # T=0: no record in sidecar, sentinel offset.
+            rec["topk_offset"] = -1
+            rec["topk_T"] = 0
+            rec["topk_K"] = int(K)
+    _handle(rank).write(json.dumps(rec, separators=(",", ":")) + "\n")
+
+
+def reset() -> None:
+    """Reset module state and close the file handles (final fsync of both jsonl
+    and topk sidecar binary). For tests and end-of-run cleanup."""
+    global _ENABLED, _FH, _STEP, _LAST_LAYER, _RUN_ID, _OUT_DIR
+    global _GLOBAL_PHASE, _WARMUP_EXPLICIT, _WARMUP_BATCHES, _PREFILL_ONSETS, _PREV_PHASE
+    global _TOPK_FH, _TOPK_K
+    for fh in (_FH, _TOPK_FH):
+        if fh is not None:
+            try:
+                fh.flush()
+                os.fsync(fh.fileno())
+            except (OSError, ValueError):
+                pass
+            try:
+                fh.close()
+            except Exception:
+                pass
+    _ENABLED = None
+    _FH = None
+    _TOPK_FH = None
+    _TOPK_K = None
+    _STEP = 0
+    _LAST_LAYER = -1
+    _RUN_ID = None
+    _OUT_DIR = None
+    _GLOBAL_PHASE = None
+    _WARMUP_EXPLICIT = None
+    _WARMUP_BATCHES = None
+    _PREFILL_ONSETS = 0
+    _PREV_PHASE = None
