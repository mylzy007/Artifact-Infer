diff --git a/workshop/nanovllm_moe/_test_per_step_trace.py b/workshop/nanovllm_moe/_test_per_step_trace.py
new file mode 100644
index 0000000..c2e5c12
--- /dev/null
+++ b/workshop/nanovllm_moe/_test_per_step_trace.py
@@ -0,0 +1,228 @@
+"""Smoke test for per_step_trace recorder (Stage 1/2, no GPU required).
+
+Validates:
+  1. flag OFF  -> zero overhead: record_step is a no-op, NO file created.
+  2. flag ON   -> jsonl written, format valid, all schema fields present.
+  3. GLOBAL phase (set_global_phase) drives prefill/decode label.
+  4. step_id rollover: a new step is detected when layer_id stops increasing.
+  5. GLOBAL phase None -> phase 'unknown' (no crash).
+  6. WARMUP: explicit set_warmup() is authoritative; onset+env is the fallback.
+"""
+import glob
+import json
+import os
+import tempfile
+
+from workshop.nanovllm_moe.services.utils import per_step_trace as P
+
+EXPECTED_FIELDS = {
+    "run_id", "step_id", "layer_id", "rank_id", "phase", "is_warmup",
+    "batch_index", "num_tokens", "L_send", "L_recv", "send_counts",
+    "recv_counts", "hidden_size", "elem_size", "K_eff", "K_model",
+    "E_global", "world_size", "drop_policy", "drop_rate", "is_source_leader",
+}
+
+
+def _call(layer_id, rank=0, with_topk=False):
+    kwargs = dict(
+        layer_id=layer_id, rank=rank,
+        send_counts=[10, 20, 30, 40, 0, 5, 5, 5],
+        recv_counts=[8, 8, 8, 8, 8, 8, 8, 8],
+        num_tokens=64, hidden_size=2048, elem_size=2,
+        k_eff=8, k_model=8, e_global=128, world_size=8,
+        drop_policy="none", drop_rate=0.0, is_source_leader=True,
+    )
+    if with_topk:
+        # 64 tokens * K=8 = 512 entries
+        kwargs["topk_ids"] = [i % 128 for i in range(512)]
+        kwargs["topk_weights"] = [0.125] * 512
+    P.record_step(**kwargs)
+
+
+def test_topk_sidecar_format_and_roundtrip():
+    """Verify the binary sidecar respects the v1 format and is byte-stable on
+    read->re-encode roundtrip; verify the jsonl carries topk_offset/T/K and
+    omits the raw arrays."""
+    import numpy as np, struct, glob
+    with tempfile.TemporaryDirectory() as d:
+        P.reset(); _env(d, "sidecar_test")
+        P.set_global_phase(True); _call(0, with_topk=False)  # no topk
+        P.set_global_phase(True); _call(1, with_topk=True)   # topk record 1
+        P.set_global_phase(False); _call(0, with_topk=True)  # topk record 2 (step rollover)
+        P.reset()
+        recs = _read(d)
+        # jsonl carries pointers, NOT raw arrays
+        assert "topk_ids" not in recs[0] and "topk_offset" not in recs[0]
+        for r in recs[1:]:
+            assert "topk_ids" not in r and "topk_weights" not in r
+            assert "topk_offset" in r and "topk_T" in r and "topk_K" in r
+            assert r["topk_T"] == 64 and r["topk_K"] == 8 and r["topk_offset"] >= 8
+
+        # binary sidecar exists, has correct file header, records are parseable
+        bins = glob.glob(os.path.join(d, "*sidecar_test*topk.bin"))
+        assert len(bins) == 1, bins
+        raw = open(bins[0], "rb").read()
+        assert raw[:4] == b"TKBN" and raw[4] == 1 and raw[5] == 8 and raw[6:8] == b"\x00\x00"
+
+        # Round-trip: read each record, re-encode, compare body bytes
+        re_encoded = bytearray(raw[:8])
+        for r in recs[1:]:
+            off = r["topk_offset"]
+            T, K = r["topk_T"], r["topk_K"]
+            step_id, layer_id, T_in = struct.unpack("<III", raw[off:off+12])
+            assert step_id == r["step_id"] and layer_id == r["layer_id"] and T_in == T
+            ids = np.frombuffer(raw[off+12:off+12+T*K], dtype="<i1")
+            w   = np.frombuffer(raw[off+12+T*K:off+12+T*K+T*K*2], dtype="<f2")
+            assert list(ids) == [i % 128 for i in range(T*K)], list(ids[:5])
+            assert all(abs(x - 0.125) < 1e-3 for x in w), w[:5]
+            # re-encode
+            re_encoded += struct.pack("<III", step_id, layer_id, T)
+            re_encoded += ids.tobytes() + w.tobytes()
+        assert bytes(re_encoded) == raw, "byte-for-byte round-trip mismatch"
+    print("OK 8: sidecar v1 file header + per-record format + byte-stable round-trip correct")
+
+
+def test_topk_sidecar_collision_hardening():
+    """Second writer to the same (run_id, rank) sidecar must raise."""
+    with tempfile.TemporaryDirectory() as d:
+        # First pass: writes both jsonl and sidecar
+        P.reset(); _env(d, "col_run")
+        os.environ.pop("MOE_COLLECT_FORCE_APPEND", None)
+        P.set_global_phase(True); _call(0, with_topk=True)
+        P.reset()
+        assert os.path.exists(os.path.join(d, "per_step_trace_col_run_rank0_topk.bin"))
+        # Second pass: both jsonl and sidecar pre-exist -> first write raises
+        P.reset(); _env(d, "col_run")
+        os.environ.pop("MOE_COLLECT_FORCE_APPEND", None)
+        P.set_global_phase(True)
+        try:
+            _call(0, with_topk=True)
+            raise AssertionError("expected FileExistsError on (run_id, rank) sidecar/jsonl collision")
+        except FileExistsError as e:
+            assert "rank0" in str(e)
+    print("OK 9: sidecar collision raises (hardening covers .bin same as .jsonl)")
+
+
+def _read(d):
+    files = glob.glob(os.path.join(d, "*.jsonl"))
+    assert len(files) == 1, f"expected 1 rank file, got {files}"
+    return [json.loads(l) for l in open(files[0]) if l.strip()]
+
+
+def _env(d, run_id, warmup_batches="0"):
+    os.environ["MOE_COLLECT_PER_STEP"] = "1"
+    os.environ["MOE_COLLECT_OUT_DIR"] = d
+    os.environ["MOE_COLLECT_RUN_ID"] = run_id
+    os.environ["MOE_COLLECT_WARMUP_BATCHES"] = warmup_batches
+
+
+def test_flag_off_zero_file():
+    with tempfile.TemporaryDirectory() as d:
+        P.reset()
+        os.environ["MOE_COLLECT_PER_STEP"] = "0"
+        os.environ["MOE_COLLECT_OUT_DIR"] = d
+        os.environ["MOE_COLLECT_RUN_ID"] = "off_test"
+        assert P.enabled() is False
+        P.set_global_phase(True)
+        for lid in range(3):
+            _call(lid)
+        assert glob.glob(os.path.join(d, "*.jsonl")) == []
+    print("OK 1: flag OFF -> no file, zero overhead")
+
+
+def test_format_and_global_phase():
+    with tempfile.TemporaryDirectory() as d:
+        P.reset(); _env(d, "on_test")
+        # step0 = prefill, step1 = decode (set GLOBAL phase per step, as engine does)
+        P.set_global_phase(True)
+        for lid in (0, 1, 2): _call(lid)
+        P.set_global_phase(False)
+        for lid in (0, 1, 2): _call(lid)
+        P.reset()
+        recs = _read(d)
+        assert len(recs) == 6
+        for r in recs:
+            assert set(r.keys()) == EXPECTED_FIELDS, set(r.keys()) ^ EXPECTED_FIELDS
+        assert recs[0]["L_send"] == 115 and recs[0]["L_recv"] == 64
+        assert [r["step_id"] for r in recs] == [0, 0, 0, 1, 1, 1]
+        assert [r["phase"] for r in recs] == ["prefill"] * 3 + ["decode"] * 3
+    print("OK 2: flag ON -> jsonl valid, all fields present")
+    print("OK 3: GLOBAL phase drives prefill/decode label")
+    print("OK 4: step_id rollover correct")
+
+
+def test_unknown_phase():
+    with tempfile.TemporaryDirectory() as d:
+        P.reset(); _env(d, "none_phase")
+        # never call set_global_phase -> _GLOBAL_PHASE None -> 'unknown'
+        _call(0)
+        P.reset()
+        assert _read(d)[0]["phase"] == "unknown"
+    print("OK 5: GLOBAL phase None -> phase 'unknown' (no crash)")
+
+
+def test_warmup_explicit_and_fallback():
+    # (a) explicit set_warmup is authoritative
+    with tempfile.TemporaryDirectory() as d:
+        P.reset(); _env(d, "warm_explicit", warmup_batches="0")
+        P.set_warmup(True);  P.set_global_phase(True);  _call(0)        # warmup batch
+        P.set_warmup(False); P.set_global_phase(True);  _call(0); _call(1)  # measured
+        P.reset()
+        recs = _read(d)
+        assert [r["is_warmup"] for r in recs] == [True, False, False], [r["is_warmup"] for r in recs]
+    # (b) fallback: no set_warmup -> onset vs MOE_COLLECT_WARMUP_BATCHES=1 on GLOBAL phase
+    with tempfile.TemporaryDirectory() as d:
+        P.reset(); _env(d, "warm_fallback", warmup_batches="1")
+        # batch1 (onset1=warmup): prefill+decode ; batch2 (onset2=measured): prefill+decode
+        seq = [(0, True), (1, True), (0, False), (1, False),   # batch1
+               (0, True), (1, True), (0, False), (1, False)]   # batch2
+        for lid, pf in seq:
+            P.set_global_phase(pf); _call(lid)
+        P.reset()
+        recs = _read(d)
+        assert [r["batch_index"] for r in recs] == [1, 1, 1, 1, 2, 2, 2, 2], [r["batch_index"] for r in recs]
+        assert [r["is_warmup"] for r in recs] == [True] * 4 + [False] * 4, [r["is_warmup"] for r in recs]
+    print("OK 6: warmup explicit authoritative + onset-fallback both correct")
+
+
+def test_no_append_collision():
+    # GATE C hardening: a 2nd write to the same (run_id, rank) file must raise.
+    with tempfile.TemporaryDirectory() as d:
+        # pass 1 — creates the file
+        P.reset(); _env(d, "collide_run")
+        os.environ.pop("MOE_COLLECT_FORCE_APPEND", None)
+        P.set_global_phase(True); _call(0); _call(1)
+        P.reset()  # closes handle; file stays on disk
+        assert glob.glob(os.path.join(d, "*collide_run*rank0.jsonl"))
+        # pass 2 — same (run_id, rank) -> must raise FileExistsError on first write
+        P.reset(); _env(d, "collide_run")
+        os.environ.pop("MOE_COLLECT_FORCE_APPEND", None)
+        P.set_global_phase(True)
+        raised = False
+        try:
+            _call(0)
+        except FileExistsError:
+            raised = True
+        assert raised, "2nd write to same (run_id,rank) must raise FileExistsError"
+        # force-append override -> no raise, appends
+        P.reset(); _env(d, "collide_run")
+        os.environ["MOE_COLLECT_FORCE_APPEND"] = "1"
+        P.set_global_phase(True)
+        _call(0)  # should NOT raise
+        P.reset()
+        os.environ.pop("MOE_COLLECT_FORCE_APPEND", None)
+        n = len(open(glob.glob(os.path.join(d, "*collide_run*rank0.jsonl"))[0]).readlines())
+        assert n >= 3, f"force-append should have appended, got {n} lines"
+    print("OK 7: append-collision raises; MOE_COLLECT_FORCE_APPEND=1 overrides")
+
+
+if __name__ == "__main__":
+    test_flag_off_zero_file()
+    test_format_and_global_phase()
+    test_unknown_phase()
+    test_warmup_explicit_and_fallback()
+    test_no_append_collision()
+    test_topk_sidecar_format_and_roundtrip()
+    test_topk_sidecar_collision_hardening()
+    P.reset()
+    print("\nALL SMOKE TESTS PASSED")
